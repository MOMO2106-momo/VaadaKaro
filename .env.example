# Required
DATABASE_URL="postgresql://user:pass@host:5432/vaadakaro"
# Optional but recommended: a separate pooled/direct connection for Prisma migrations (see prisma/schema.prisma directUrl)
DIRECT_URL="postgresql://user:pass@host:5432/vaadakaro"
AUTH_SECRET="<random 32+ char string — REQUIRED in production, app will refuse to start without it>"
NEXTAUTH_URL="https://your-production-domain.run.app"
AUTH_URL="https://your-production-domain.run.app"
AUTH_TRUST_HOST="1"

# Demo mode (hackathon/judging only) — lets the `demo_role` cookie and the
# login page's "Quick Portal Access" buttons grant a role WITHOUT a real
# login. This is a real privilege-escalation risk if left on in production.
# Leave both unset/false in any deployment with real user data.
# ENABLE_DEMO_MODE="true"
# NEXT_PUBLIC_ENABLE_DEMO_MODE="true"

# Gemini API Keys — split by workload to avoid quota exhaustion
# CHAT: Civic Copilot multi-turn conversations (/ai-assistant)
GEMINI_API_KEY_CHAT="<Google AI Studio key for chat>"
# ANALYSIS: Complaint scoring, health checks, intelligence summaries
GEMINI_API_KEY_ANALYSIS="<Google AI Studio key for analysis>"
# DOCUMENTS: Legal document generation (/generate-docs)
GEMINI_API_KEY_DOCUMENTS="<Google AI Studio key for documents>"

# Legacy fallback — used only if the role-specific keys above are not set
# GEMINI_API_KEY=""

# Optional — Cloudinary (complaint photo uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional — SMTP (email notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
GOVT_EMAIL_GENERAL=""

# Legacy — no longer used (migrated to GEMINI_API_KEY)
# NEXT_PUBLIC_OPENROUTER_KEY=""
